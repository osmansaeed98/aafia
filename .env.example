# Names of the settings the app needs. Put the real values in Vercel
# (Project → Settings → Environment Variables) or a local .env.local
# file, which is never committed. Never put real values in this file.

# Supabase → Project Settings → API Keys. Both are public by design:
# the database's access rules decide what anyone can see or change.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Only for running database changes and tests from a computer
# (Claude's cloud session gets this automatically).
# SUPABASE_ACCESS_TOKEN=
