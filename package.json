{
  "name": "aafia",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "npm run test:unit && npm run test:db && npm run build && npm run test:app",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "test:app": "NODE_USE_ENV_PROXY=1 node --test --test-concurrency=1 \"tests/app/*.test.js\"",
    "test:db": "NODE_USE_ENV_PROXY=1 node --test \"tests/db/*.test.js\"",
    "db:migrate": "NODE_USE_ENV_PROXY=1 node scripts/db-migrate.js"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "standardwebhooks": "1.1.1"
  },
  "devDependencies": {
    "playwright": "1.63.0"
  },
  "type": "module"
}
